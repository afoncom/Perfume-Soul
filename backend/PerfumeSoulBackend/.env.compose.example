# Use a strong alphanumeric password because this value is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Used by `swift run PerfumeSoulBackend`; local Compose publishes PostgreSQL on 127.0.0.1:5432.
DATABASE_URL=postgresql://perfumesoul:change-me@localhost:5432/perfumesoul

# Optional. Use a commit tag for pinned VPS deploys or rollbacks.
# BACKEND_IMAGE_TAG=latest

# VPS only. Uncomment to prevent docker-compose.override.yml from being auto-merged on the server.
# COMPOSE_FILE=docker-compose.yml
